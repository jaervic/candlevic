# Copia este archivo a .env.local para activar el respaldo en la nube.
# Sin estas variables la app funciona igual: el respaldo cifrado queda
# desactivado y se ofrece exportar/importar el progreso como archivo.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analítica opcional, agregada y sin cookies (Umami).
# Si no se configura, no se carga ningún script.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
